{
  "name": "suri-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0"
  },
  "workspaces": [
    "packages/*",
    "apps/host",
    "apps/web"
  ],
  "scripts": {
    "browser": "node scripts/browser.mjs",
    "recover": "node scripts/recover.mjs",
    "test:recovery": "node --test tests/recovery.test.mjs",
    "test:recovery:live": "node --test tests/recovery-live.test.mjs",
    "browser:reload-ui": "node scripts/build-ui.mjs --compatibility-output && node scripts/browser.mjs --reload-ui",
    "preview": "node scripts/browser-preview.mjs",
    "preview:open": "node scripts/browser-preview.mjs --launch",
    "format:check": "prettier --check packages apps scripts tests *.json *.mjs",
    "format:portable": "prettier --check packages apps/host apps/web scripts tests *.json *.mjs",
    "format": "prettier --write packages apps scripts tests *.json *.mjs",
    "lint": "eslint packages apps/host apps/web tests scripts && node scripts/check-boundaries.mjs && node scripts/check-exports.mjs && node scripts/check-docs.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:rpc": "node scripts/rpc-tests.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/apps/host/src/cli.js open",
    "stop": "node dist/apps/host/src/cli.js shutdown",
    "test:e2e": "node scripts/playwright-tests.mjs",
    "test:executor:fixture": "node scripts/test-executor-fixture.mjs",
    "test:e2e:serial": "playwright test --workers=1",
    "test:ui-fixtures": "node scripts/ui-tests.mjs",
    "test:integration": "node scripts/integration-tests.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build:updates": "node scripts/build-updates.mjs",
    "test:updates": "npm run build:updates && vitest run tests/unit/restart-*.test.ts tests/unit/update-*.test.ts tests/unit/view-storage.test.ts tests/unit/open-browser.test.ts tests/integration/unified-updates.test.ts tests/integration/modern-client-ownership.test.ts tests/integration/host-update-launch.test.ts tests/integration/legacy-migration-admission.test.ts tests/integration/legacy-migration.test.ts tests/integration/restart-failure-recovery.test.ts tests/integration/ui-import-security.test.ts tests/integration/startup-boundaries.test.ts && playwright test tests/e2e/unified-updates.spec.ts tests/e2e/host-update-restart.spec.ts tests/e2e/restart-handoff-response-loss.spec.ts --workers=1",
    "test:self-edit": "vitest run tests/integration/self-edit.test.ts",
    "test:migrations": "vitest run tests/integration/migrations.test.ts",
    "test:a11y": "playwright test --grep accessibility",
    "package:macos": "node scripts/package-macos.mjs",
    "install:linux-shell": "node scripts/install-linux-shell.mjs",
    "test:native-dev-host": "node scripts/test-native-development-host.mjs",
    "test:native-restart": "tsx scripts/test-native-restart-lifecycle.ts",
    "verify:portable": "node scripts/verify-portable.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.4",
    "better-sqlite3": "13.0.3",
    "ws": "8.21.3",
    "node-pty": "1.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "typescript-eslint": "8.70.0",
    "prettier": "3.9.6",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/ws": "8.18.1",
    "@axe-core/playwright": "4.13.0",
    "tsx": "4.23.13"
  }
}
